<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF"
    tools:context=".EditProfileActivity">
    <!-- Floating Background Blobs -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="end"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-40dp"
        android:alpha="0.18"
        android:background="@drawable/blur_circle_purple" />
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="-50dp"
        android:layout_marginBottom="80dp"
        android:alpha="0.12"
        android:background="@drawable/blur_circle_violet" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="100dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="52dp"
                android:paddingBottom="8dp">
                <!-- Back Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="#B3FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_menu_revert"
                        app:tint="#1A1A2E" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:text="Edit Profile"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <!-- Placeholder for symmetry -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:visibility="invisible" />
            </LinearLayout>
            <!-- Profile Picture Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="55dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#E0D4FC"
                        app:strokeWidth="3dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="#EDE9FE"
                            app:cardCornerRadius="48dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgProfile"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Profile Picture"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_person_small"
                                app:tint="#7A9096" />
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="2dp"
                        app:cardBackgroundColor="#7A9096"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Change Photo"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#FFFFFF" />
                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Change Photo"
                    android:textColor="#7A9096"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!-- Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <!-- Full Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="#7A9096"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#F9F7FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/input_stroke_color"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Name"
                                android:src="@drawable/ic_person_small"
                                app:tint="#7A9096" />
                            <EditText
                                android:id="@+id/etFullName"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:background="@null"
                                android:fontFamily="sans-serif-medium"
                                android:hint="Enter your full name"
                                android:inputType="textPersonName"
                                android:textColor="#1A1A2E"
                                android:textColorHint="#B0A4D4"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- Birthday Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Birthday"
                        android:textColor="#7A9096"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBirthday"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#F9F7FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/input_stroke_color"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Birthday"
                                android:src="@drawable/ic_birthday_icon"
                                app:tint="#7A9096" />
                            <TextView
                                android:id="@+id/tvBirthday"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:hint="Select your birthday"
                                android:textColor="#1A1A2E"
                                android:textColorHint="#B0A4D4"
                                android:textSize="14sp" />
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Pick Date"
                                android:src="@android:drawable/arrow_down_float"
                                app:tint="#7A9096" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- Phone Number Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Phone Number"
                        android:textColor="#7A9096"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#F9F7FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/input_stroke_color"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Phone"
                                android:src="@android:drawable/ic_menu_call"
                                app:tint="#7A9096" />
                            <EditText
                                android:id="@+id/etPhone"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:background="@null"
                                android:fontFamily="sans-serif-medium"
                                android:hint="Enter phone number"
                                android:inputType="phone"
                                android:textColor="#1A1A2E"
                                android:textColorHint="#B0A4D4"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- Email Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Email Address"
                        android:textColor="#7A9096"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#F9F7FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/input_stroke_color"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Email"
                                android:src="@android:drawable/ic_dialog_email"
                                app:tint="#7A9096" />
                            <EditText
                                android:id="@+id/etEmail"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:background="@null"
                                android:fontFamily="sans-serif-medium"
                                android:hint="Enter email address"
                                android:inputType="textEmailAddress"
                                android:textColor="#1A1A2E"
                                android:textColorHint="#B0A4D4"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- Address Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Address"
                        android:textColor="#7A9096"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="80dp"
                        app:cardBackgroundColor="#F9F7FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/input_stroke_color"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginTop="2dp"
                                android:contentDescription="Address"
                                android:src="@drawable/ic_location_icon"
                                app:tint="#7A9096" />
                            <EditText
                                android:id="@+id/etAddress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:background="@null"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="top|start"
                                android:hint="Enter your full address"
                                android:inputType="textMultiLine"
                                android:minLines="3"
                                android:textColor="#1A1A2E"
                                android:textColorHint="#B0A4D4"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
    <!-- Bottom Save Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/main_color"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="16dp" />
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>