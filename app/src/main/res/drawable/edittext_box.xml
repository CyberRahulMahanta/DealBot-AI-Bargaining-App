<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background Color -->
    <solid android:color="#FFFFFF"/>

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#BDBDBD"/>

    <!-- Rounded Corners -->
    <corners android:radius="12dp"/>

    <!-- Inner Padding -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="12dp"
        android:bottom="12dp"/>
</shape>